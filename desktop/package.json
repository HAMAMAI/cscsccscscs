{
  "name": "takt-desktop",
  "productName": "Такт",
  "version": "1.0.2",
  "private": true,
  "description": "Desktop client for Takt messenger",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.78.0",
    "livekit-client": "2.21.0",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "37.3.1",
    "electron-builder": "26.0.12",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  },
  "build": {
    "appId": "app.takt.desktop",
    "productName": "Такт",
    "artifactName": "Takt-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
